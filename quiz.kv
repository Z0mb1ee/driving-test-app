#:kivy 2.3.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<FilterSpinnerOption@SpinnerOption>:
    size_hint_y: None
    height: max(dp(48), self.texture_size[1] + dp(18))
    text_size: self.width - dp(20), None
    halign: 'center'
    valign: 'middle'

<WindowManager>:
    MenuScreen:
    StatsScreen:
    AddQuestionScreen:
    ViewQuestionsScreen:
    QuestionPreviewScreen:
    EditQuestionScreen:
    TestSettingsScreen:
    ActiveTestScreen:
    TestSummaryScreen:

<MenuScreen>:
    name: 'menu'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(24)
        spacing: dp(12)
        Label:
            text: 'Testy Vedenia Vozidiel'
            font_size: sp(30)
            size_hint_y: None
            height: dp(52)
            halign: 'center'
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(10)
            Label:
                text: 'Orientácia'
                size_hint_x: 0.38
                font_size: sp(16)
            Spinner:
                text: app.orientation_mode
                values: ['Automaticky', 'Na výšku', 'Na šírku']
                font_size: sp(16)
                on_text: app.set_orientation(self.text)
        Button:
            text: 'Začať Test'
            font_size: sp(18)
            text_size: self.width - dp(24), self.height - dp(12)
            halign: 'center'
            valign: 'middle'
            on_press: root.go_to_test_settings()
        Button:
            text: 'Štatistiky a Úspešnosť'
            font_size: sp(18)
            text_size: self.width - dp(24), self.height - dp(12)
            halign: 'center'
            valign: 'middle'
            background_color: 0.1, 0.5, 0.8, 1
            on_press: root.go_to_stats()
        Button:
            text: 'Pridať Otázku'
            font_size: sp(18)
            text_size: self.width - dp(24), self.height - dp(12)
            halign: 'center'
            valign: 'middle'
            on_press: root.manager.current = 'add_question'
        Button:
            text: 'Prehľad a databáza otázok'
            font_size: sp(18)
            text_size: self.width - dp(24), self.height - dp(12)
            halign: 'center'
            valign: 'middle'
            on_press: root.manager.current = 'view_questions'

<StatsScreen>:
    name: 'stats'
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15
        Label:
            text: 'Štatistiky a Prehľad Úspešnosti'
            font_size: 24
            bold: True
            size_hint_y: None
            height: 40
            halign: 'center'
        Label:
            id: stats_summary_label
            text: 'Načítavam štatistiky...'
            font_size: 16
            size_hint_y: None
            height: 60
            halign: 'center'
        Label:
            text: 'Úspešnosť podľa kategórií:'
            font_size: 18
            bold: True
            size_hint_y: None
            height: 30
            halign: 'left'
        ScrollView:
            BoxLayout:
                id: stats_categories_layout
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 5
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            Button:
                text: 'Vymazať štatistiky'
                background_color: 0.8, 0.2, 0.2, 1
                on_press: root.clear_stats()
            Button:
                text: 'Späť do Menu'
                background_color: 0.2, 0.5, 0.9, 1
                on_press: root.manager.current = 'menu'

<AddQuestionScreen>:
    name: 'add_question'
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10
        Label:
            text: 'Pridať Novú Otázku'
            font_size: 22
            size_hint_y: None
            height: 40
        BoxLayout:
            size_hint_y: None
            height: 40
            spacing: 10
            Label:
                text: 'Kategória:'
            Spinner:
                id: cat_spinner
                text: 'Pravidlá cestnej premávky'
                values: ['Pravidlá cestnej premávky', 'Uplatňovanie pravidiel prednosti v jazde a rýchlostné obmedzenia', 'Dopravné značky a dopravné zariadenia', 'Dopravné situácie na križovatkách', 'Všeobecné pravidlá správania sa v prípade dopravnej nehody', 'Teória vedenia vozidla', 'Predpisy týkajúce sa dokladov požadovaných v prípade používania vozidla a organizácia času v doprave', 'Podmienky prevádzky vozidiel v premávke na pozemnych komunikáciách', 'Zásady bezpečnej jazdy', 'Konštrukcia vozidiel a ich údržba']
                on_text: root.on_category_changed(self.text)
        
        Label:
            id: points_label
            text: 'Body: 3 (automaticky)'
            font_size: 16
            size_hint_y: None
            height: 30
            color: (1, 0.8, 0, 1)

        TextInput:
            id: q_text
            hint_text: 'Zadajte text otázky...'
            multiline: False
            size_hint_y: None
            height: 40
        
        BoxLayout:
            size_hint_y: None
            height: 40
            spacing: 10
            Button:
                text: 'Vložiť obrázok zo schránky (Ctrl+V)'
                on_press: root.paste_image()
            Label:
                id: img_status_label
                text: 'Žiadny obrázok nie je vložený'
                color: 0.7, 0.7, 0.7, 1

        BoxLayout:
            id: preview_container
            size_hint_y: 1

        TextInput:
            id: opt_a
            hint_text: 'Možnosť A'
            multiline: False
            size_hint_y: None
            height: 40
        TextInput:
            id: opt_b
            hint_text: 'Možnosť B'
            multiline: False
            size_hint_y: None
            height: 40
        TextInput:
            id: opt_c
            hint_text: 'Možnosť C'
            multiline: False
            size_hint_y: None
            height: 40
        BoxLayout:
            size_hint_y: None
            height: 40
            spacing: 10
            Label:
                text: 'Správna:'
            Spinner:
                id: correct_spinner
                text: 'A'
                values: ['A', 'B', 'C']
            Label:
                text: 'Status:'
            Spinner:
                id: status_spinner
                text: 'Nepoznám'
                values: ['Nepoznám', 'Neviem', 'Neistý', 'Viem']
        Button:
            text: 'Uložiť Otázku'
            size_hint_y: None
            height: 50
            on_press: root.save_question(cat_spinner, q_text, opt_a, opt_b, opt_c, correct_spinner, status_spinner)
        Button:
            text: 'Späť do Menu'
            size_hint_y: None
            height: 50
            on_press: root.manager.current = 'menu'

<ViewQuestionsScreen>:
    name: 'view_questions'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        Label:
            text: 'Databáza Otázok'
            font_size: sp(23)
            size_hint_y: None
            height: dp(38)
            
        Label:
            id: count_label
            text: 'Načítavam počty...'
            font_size: sp(14)
            size_hint_y: None
            height: dp(28)
            color: (0.9, 0.8, 0.2, 1)

        TextInput:
            id: search_box
            hint_text: 'Hľadať v otázkach...'
            size_hint_y: None
            height: dp(46)
            font_size: sp(16)
            multiline: False
            on_text: root.schedule_search()
        
        GridLayout:
            cols: max(1, int((self.width + dp(6)) / dp(186)))
            size_hint_y: None
            height: self.minimum_height
            row_default_height: dp(76)
            row_force_default: True
            spacing: dp(6)
            Spinner:
                id: cat_filter
                text: 'Všetky kategórie'
                values: ['Všetky kategórie', 'Pravidlá cestnej premávky', 'Uplatňovanie pravidiel prednosti v jazde a rýchlostné obmedzenia', 'Dopravné značky a dopravné zariadenia', 'Dopravné situácie na križovatkách', 'Všeobecné pravidlá správania sa v prípade dopravnej nehody', 'Teória vedenia vozidla', 'Predpisy týkajúce sa dokladov požadovaných v prípade používania vozidla a organizácia času v doprave', 'Podmienky prevádzky vozidiel v premávke na pozemnych komunikáciách', 'Zásady bezpečnej jazdy', 'Konštrukcia vozidiel a ich údržba']
                option_cls: 'FilterSpinnerOption'
                font_size: sp(14)
                text_size: self.width - dp(24), self.height - dp(10)
                halign: 'center'
                valign: 'middle'
                on_text: root.load_questions()
            Spinner:
                id: status_filter
                text: 'Všetky statusy'
                values: ['Všetky statusy', '❓ Nepoznám', '🔴 Neviem', '🟡 Neistý', '🟢 Viem']
                option_cls: 'FilterSpinnerOption'
                font_size: sp(14)
                text_size: self.width - dp(24), self.height - dp(10)
                halign: 'center'
                valign: 'middle'
                on_text: root.load_questions()
            Spinner:
                id: sort_filter
                text: 'Zoradiť podľa obtiažnosti'
                values: ['Zoradiť podľa obtiažnosti', 'Najťažšie prvé', 'Najľahšie prvé']
                option_cls: 'FilterSpinnerOption'
                font_size: sp(14)
                text_size: self.width - dp(24), self.height - dp(10)
                halign: 'center'
                valign: 'middle'
                on_text: root.load_questions()
            Button:
                text: 'Hľadať\nduplikáty'
                background_color: (0.9, 0.6, 0.1, 1)
                font_size: sp(15)
                text_size: self.width - dp(16), self.height - dp(8)
                halign: 'center'
                valign: 'middle'
                on_press: root.check_duplicates()

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(5)
            BoxLayout:
                id: questions_list_layout
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(6)
        Button:
            text: 'Späť do Menu'
            size_hint_y: None
            height: dp(46)
            font_size: sp(16)
            on_press: root.manager.current = 'menu'

<QuestionPreviewScreen>:
    name: 'question_preview'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(6)
        Label:
            id: prev_header
            text: 'Náhľad otázky'
            font_size: sp(16)
            size_hint_y: None
            height: dp(44)
            text_size: self.width - dp(8), self.height
            halign: 'left'
            valign: 'middle'
        ScrollView:
            id: preview_scroll
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(5)
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
                padding: dp(4), dp(4), dp(8), dp(12)
                Label:
                    id: prev_text
                    text: 'Text...'
                    font_size: sp(20)
                    size_hint_y: None
                    height: self.texture_size[1] + dp(18)
                    text_size: self.width - dp(12), None
                    halign: 'left'
                    valign: 'top'
                BoxLayout:
                    id: prev_image_container
                    size_hint_y: None
                    height: min(dp(360), max(dp(150), preview_scroll.height * 0.42)) if self.children else 0
                Button:
                    id: prev_opt_a
                    text: 'A)'
                    font_size: sp(18)
                    size_hint_y: None
                    height: max(dp(52), self.texture_size[1] + dp(20))
                    text_size: self.width - dp(24), None
                    padding: dp(12), dp(8)
                    halign: 'left'
                    valign: 'middle'
                Button:
                    id: prev_opt_b
                    text: 'B)'
                    font_size: sp(18)
                    size_hint_y: None
                    height: max(dp(52), self.texture_size[1] + dp(20))
                    text_size: self.width - dp(24), None
                    padding: dp(12), dp(8)
                    halign: 'left'
                    valign: 'middle'
                Button:
                    id: prev_opt_c
                    text: 'C)'
                    font_size: sp(18)
                    size_hint_y: None
                    height: max(dp(52), self.texture_size[1] + dp(20))
                    text_size: self.width - dp(24), None
                    padding: dp(12), dp(8)
                    halign: 'left'
                    valign: 'middle'
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(8)
            Button:
                text: 'Predchádzajúca'
                font_size: sp(14)
                on_press: root.prev_question()
            Button:
                text: 'Ďalšia'
                font_size: sp(14)
                on_press: root.next_question()
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(6)
            Button:
                text: 'Upraviť'
                font_size: sp(14)
                background_color: 0.2, 0.5, 0.9, 1
                on_press: root.go_to_edit()
            Button:
                text: 'Resetovať'
                font_size: sp(14)
                background_color: 0.9, 0.6, 0.1, 1
                on_press: root.reset_this_question()
            Button:
                text: 'Zmazať'
                font_size: sp(14)
                background_color: 0.8, 0.2, 0.2, 1
                on_press: root.delete_this_question()
        Button:
            text: 'Späť do Prehľadu'
            size_hint_y: None
            height: dp(44)
            font_size: sp(15)
            on_press: root.manager.current = 'view_questions'

<EditQuestionScreen>:
    name: 'edit_question'
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 8
        Label:
            text: 'Upraviť Otázku'
            font_size: 20
            size_hint_y: None
            height: 30
        
        Label:
            id: edit_difficulty_label
            text: 'Automatická obtiažnosť: 1 / 5'
            font_size: 14
            size_hint_y: None
            height: 25
            color: (1, 0.8, 0, 1)

        BoxLayout:
            size_hint_y: None
            height: 35
            spacing: 10
            Label:
                text: 'Kategória:'
                size_hint_x: 0.3
            Spinner:
                id: edit_cat_spinner
                values: ['Pravidlá cestnej premávky', 'Uplatňovanie pravidiel prednosti v jazde a rýchlostné obmedzenia', 'Dopravné značky a dopravné zariadenia', 'Dopravné situácie na križovatkách', 'Všeobecné pravidlá správania sa v prípade dopravnej nehody', 'Teória vedenia vozidla', 'Predpisy týkajúce sa dokladov požadovaných v prípade používania vozidla a organizácia času v doprave', 'Podmienky prevádzky vozidiel v premávke na pozemnych komunikáciách', 'Zásady bezpečnej jazdy', 'Konštrukcia vozidiel a ich údržba']
                on_text: root.on_category_changed(self.text)

        Label:
            id: edit_points_label
            text: 'Body: 3 (automaticky)'
            font_size: 14
            size_hint_y: None
            height: 25
            color: (1, 0.8, 0, 1)

        TextInput:
            id: edit_q_text
            multiline: False
            size_hint_y: None
            height: 35
        
        BoxLayout:
            size_hint_y: None
            height: 35
            spacing: 10
            Button:
                text: 'Zmeniť obrázok (Ctrl+V)'
                on_press: root.paste_image()
            Label:
                id: edit_img_status
                text: 'Stav obrázka'
                color: 0.7, 0.7, 0.7, 1

        BoxLayout:
            id: edit_preview_container
            size_hint_y: 1

        TextInput:
            id: edit_opt_a
            multiline: False
            size_hint_y: None
            height: 35
        TextInput:
            id: edit_opt_b
            multiline: False
            size_hint_y: None
            height: 35
        TextInput:
            id: edit_opt_c
            multiline: False
            size_hint_y: None
            height: 35
        
        BoxLayout:
            size_hint_y: None
            height: 35
            spacing: 10
            Label:
                text: 'Správna:'
                size_hint_x: 0.2
            Spinner:
                id: edit_correct_spinner
                values: ['A', 'B', 'C']
            Label:
                text: 'Status:'
                size_hint_x: 0.2
            Spinner:
                id: edit_status_spinner
                values: ['Nepoznám', 'Neviem', 'Neistý', 'Viem']

        BoxLayout:
            size_hint_y: None
            height: 45
            spacing: 10
            Button:
                text: '⬅ Predchádzajúca'
                background_color: 0.3, 0.3, 0.3, 1
                on_press: root.prev_question()
            Button:
                text: '💾 Uložiť zmeny'
                background_color: 0.2, 0.5, 0.9, 1
                on_press: root.save_changes()
            Button:
                text: '💾 Uložiť & Ďalšia ➡'
                background_color: 0.1, 0.6, 0.2, 1
                on_press: root.save_and_next()
            Button:
                text: 'Ďalšia ➡'
                background_color: 0.3, 0.3, 0.3, 1
                on_press: root.next_question()

        Button:
            text: 'Hotovo / Späť do prehľadu'
            size_hint_y: None
            height: 45
            on_press: root.manager.current = 'view_questions'

<TestSettingsScreen>:
    name: 'test_settings'
    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 20
        Label:
            text: 'Nastavenia Testu'
            font_size: 26
            size_hint_y: None
            height: 40
            halign: 'center'
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 15
            Label:
                text: 'Režim testu:'
                font_size: 18
            Spinner:
                id: mode_spinner
                text: 'Cielený (Smart)'
                values: ['Cielený (Smart)', 'Prioritný (Nepoznané prvé)', 'Náhodný (Random)']
                font_size: 16
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 15
            Label:
                text: 'Kategória:'
                font_size: 18
            Spinner:
                id: category_spinner
                text: 'Všetky kategórie'
                values: ['Všetky kategórie', 'Problematické kategórie', 'Pravidlá cestnej premávky', 'Uplatňovanie pravidiel prednosti v jazde a rýchlostné obmedzenia', 'Dopravné značky a dopravné zariadenia', 'Dopravné situácie na križovatkách', 'Všeobecné pravidlá správania sa v prípade dopravnej nehody', 'Teória vedenia vozidla', 'Predpisy týkajúce sa dokladov požadovaných v prípade používania vozidla a organizácia času v doprave', 'Podmienky prevádzky vozidiel v premávke na pozemnych komunikáciách', 'Zásady bezpečnej jazdy', 'Konštrukcia vozidiel a ich údržba']
                font_size: 16
        BoxLayout:
            size_hint_y: None
            height: 20
        Button:
            text: 'Vygenerovať a Spustiť Test'
            font_size: 18
            size_hint_y: None
            height: 55
            background_color: 0.1, 0.6, 0.2, 1
            on_press: root.start_configured_test(mode_spinner, category_spinner)
        Button:
            text: 'Späť do Menu'
            font_size: 16
            size_hint_y: None
            height: 45
            on_press: root.manager.current = 'menu'

<ActiveTestScreen>:
    name: 'active_test'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(6)
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: timer_row.height + top_questions_grid.height + dp(4)
            BoxLayout:
                id: timer_row
                size_hint_y: None
                height: dp(44)
                spacing: dp(8)
                Label:
                    id: timer_label
                    text: 'Čas: 30:00'
                    font_size: sp(15)
                    size_hint_x: 0.52
                Spinner:
                    text: app.orientation_mode
                    values: ['Automaticky', 'Na výšku', 'Na šírku']
                    font_size: sp(14)
                    on_text: root.set_orientation(self.text)
            GridLayout:
                id: top_questions_grid
                cols: max(1, int((self.width + dp(4)) / dp(48)))
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
                row_default_height: dp(40)
                row_force_default: True
        BoxLayout:
            orientation: 'vertical'
            spacing: dp(6)
            Label:
                id: q_header_label
                text: 'Otázka č. 1 za 1 b'
                font_size: sp(20)
                size_hint_y: None
                height: dp(32)
                halign: 'left'
                text_size: self.width, self.height
            ScrollView:
                id: question_scroll
                do_scroll_x: False
                do_scroll_y: True
                bar_width: dp(5)
                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
                    padding: dp(2), dp(4), dp(8), dp(12)
                    Label:
                        id: q_category_label
                        text: ''
                        font_size: sp(15)
                        size_hint_y: None
                        height: self.texture_size[1] + dp(8)
                        text_size: self.width - dp(8), None
                        halign: 'left'
                        valign: 'middle'
                    Label:
                        id: q_text_label
                        text: 'Text otázky...'
                        font_size: sp(21)
                        size_hint_y: None
                        height: self.texture_size[1] + dp(18)
                        text_size: self.width - dp(8), None
                        halign: 'left'
                        valign: 'top'
                    BoxLayout:
                        id: test_image_container
                        size_hint_y: None
                        height: min(dp(360), max(dp(150), question_scroll.height * 0.42)) if self.children else 0
                    Button:
                        id: opt_a_btn
                        text: 'A) Možnosť A'
                        font_size: sp(18)
                        size_hint_y: None
                        height: max(dp(52), self.texture_size[1] + dp(20))
                        text_size: self.width - dp(24), None
                        padding: dp(12), dp(8)
                        halign: 'left'
                        valign: 'middle'
                        on_press: root.select_answer(0)
                    Button:
                        id: opt_b_btn
                        text: 'B) Možnosť B'
                        font_size: sp(18)
                        size_hint_y: None
                        height: max(dp(52), self.texture_size[1] + dp(20))
                        text_size: self.width - dp(24), None
                        padding: dp(12), dp(8)
                        halign: 'left'
                        valign: 'middle'
                        on_press: root.select_answer(1)
                    Button:
                        id: opt_c_btn
                        text: 'C) Možnosť C'
                        font_size: sp(18)
                        size_hint_y: None
                        height: max(dp(52), self.texture_size[1] + dp(20))
                        text_size: self.width - dp(24), None
                        padding: dp(12), dp(8)
                        halign: 'left'
                        valign: 'middle'
                        on_press: root.select_answer(2)
            BoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(8)
                Button:
                    text: 'Predchádzajúca'
                    font_size: sp(14)
                    on_press: root.prev_question()
                Button:
                    text: 'Ďalšia'
                    font_size: sp(14)
                    on_press: root.next_question()
                Button:
                    text: 'Ukončiť'
                    font_size: sp(14)
                    background_color: 0.1, 0.6, 0.2, 1
                    on_press: root.finish_test()

<TestSummaryScreen>:
    name: 'test_summary'
    ScrollView:
        BoxLayout:
            orientation: 'vertical'
            padding: 20
            spacing: 15
            size_hint_y: None
            height: self.minimum_height
            
            BoxLayout:
                size_hint_y: None
                height: 40
                spacing: 20
                Label:
                    id: summary_status_label
                    text: 'Výsledok testu'
                    font_size: 18
                    bold: True
                Label:
                    id: summary_score_label
                    text: 'Skóre'
                    font_size: 16
                Label:
                    id: summary_time_label
                    text: 'Čas: 00:00'
                    font_size: 16

            ScrollView:
                size_hint_y: None
                height: 45
                do_scroll_y: False
                BoxLayout:
                    id: summary_grid
                    orientation: 'horizontal'
                    size_hint_x: None
                    width: self.minimum_width
                    spacing: 4

            BoxLayout:
                orientation: 'vertical'
                spacing: 8
                size_hint_y: None
                height: 500
                Label:
                    id: det_header
                    text: 'Otázka č. 1'
                    font_size: 16
                    size_hint_y: None
                    height: 25
                    halign: 'left'
                Label:
                    id: det_text
                    text: 'Text...'
                    font_size: 15
                    size_hint_y: None
                    height: 40
                    text_size: self.width, None
                    halign: 'left'
                
                BoxLayout:
                    id: det_image_container
                    size_hint_y: 1

                Button:
                    id: det_opt_a
                    text: 'A)'
                    size_hint_y: None
                    height: 40
                    text_size: self.width - 20, None
                    halign: 'left'
                Button:
                    id: det_opt_b
                    text: 'B)'
                    size_hint_y: None
                    height: 40
                    text_size: self.width - 20, None
                    halign: 'left'
                Button:
                    id: det_opt_c
                    text: 'C)'
                    size_hint_y: None
                    height: 40
                    text_size: self.width - 20, None
                    halign: 'left'

            BoxLayout:
                size_hint_y: None
                height: 45
                spacing: 10
                Button:
                    text: 'Predchádzajúca otázka'
                    on_press: root.prev_detail()
                Button:
                    text: 'Ďalšia otázka'
                    on_press: root.next_detail()

            Label:
                text: 'Prehľad kategórií'
                font_size: 20
                bold: True
                size_hint_y: None
                height: 35
                halign: 'left'

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 10
                Label:
                    text: 'Kategória'
                    size_hint_x: 0.5
                    bold: True
                    font_size: 13
                    halign: 'left'
                Label:
                    text: 'Správne'
                    size_hint_x: 0.15
                    bold: True
                    font_size: 13
                Label:
                    text: 'Body'
                    size_hint_x: 0.15
                    bold: True
                    font_size: 13
                Label:
                    text: 'Úspešnosť'
                    size_hint_x: 0.2
                    bold: True
                    font_size: 13

            BoxLayout:
                id: categories_table_layout
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: 5

            Button:
                text: 'Späť do Hlavného Menu'
                size_hint_y: None
                height: 50
                background_color: 0.2, 0.5, 0.9, 1
                on_press: root.manager.current = 'menu'